# Copy to .env on the VM:  cp .env.example .env
# NEVER commit .env (it is gitignored). Generate secrets with: openssl rand -hex 32

# --- Public hostname (set automatically by scripts/setup-vm.sh) ---
CADDY_DOMAIN=123-456-789-10.sslip.io
# Suggested Cloudflare Pages project: bazario -> https://bazario.pages.dev
FRONTEND_URL=https://bazario.pages.dev

# --- Database (single Postgres container, 7 databases) ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=ecommerce

# --- Internal service-to-service secret (must match in gateway + all services) ---
GATEWAY_INTERNAL_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32

# --- JWT RSA keys (base64 DER, generated by scripts/setup-vm.sh) ---
JWT_PRIVATE_KEY=CHANGE_ME_WITH_BASE64_PKCS8_DER
JWT_PUBLIC_KEY=CHANGE_ME_WITH_BASE64_X509_DER

# --- CORS: comma-separated list of allowed browser origins ---
CORS_ALLOWED_ORIGINS=https://bazario.pages.dev,http://localhost:4200

# --- Stripe (test keys only; leave blank to disable checkout) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://bazario.pages.dev/payment/success?sessionId={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://bazario.pages.dev/payment/cancel

# --- Optional per-service JVM tuning ---
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m
