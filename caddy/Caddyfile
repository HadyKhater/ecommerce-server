# Caddy terminates TLS automatically (Let's Encrypt) and is the ONLY container
# that publishes ports 80/443. CADDY_DOMAIN is injected from .env.
{$CADDY_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy gateway:8080

	log {
		output stdout
		format console
	}
}
